{
  "name": "@kud/sonarqube-cli",
  "version": "0.2.0",
  "description": "SonarQube from the terminal: quality gate, metrics, issues, hotspots and rules, with an interactive issues dashboard.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "bin": {
    "sonarqube": "dist/bin/sonarqube.js",
    "sonarqube-dash": "dist/bin/sonarqube.js"
  },
  "files": [
    "dist/bin",
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx bin/sonarqube.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sonarqube",
    "sonar",
    "quality-gate",
    "code-quality",
    "cli",
    "tui",
    "terminal",
    "issues",
    "static-analysis"
  ],
  "author": "Erwann Mest <m@kud.io>",
  "license": "MIT",
  "homepage": "https://github.com/kud/sonarqube-cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/kud/sonarqube-cli"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kud/sonarqube": "^0.1.0",
    "blessed": "0.1.81",
    "chalk": "5.6.2",
    "cli-highlight": "2.1.11",
    "commander": "14.0.0"
  },
  "devDependencies": {
    "@types/blessed": "0.1.27",
    "@types/node": "24.3.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
